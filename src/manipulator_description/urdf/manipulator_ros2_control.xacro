<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="manipulator_ros2_control" params="name use_mock_hardware:=false">
    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${use_mock_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </xacro:if>
        <xacro:unless value="${use_mock_hardware}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:unless>
      </hardware>

      <xacro:macro name="joint_interface" params="joint_name p_min p_max v_max">
        <joint name="${joint_name}">
          <command_interface name="position">
            <param name="min">${p_min}</param>
            <param name="max">${p_max}</param>
          </command_interface>
          <command_interface name="velocity"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
      </xacro:macro>

      <xacro:joint_interface joint_name="joint_1" p_min="-3.14159" p_max="3.14159" v_max="3.14"/>
      <xacro:joint_interface joint_name="joint_2" p_min="-2.0944"  p_max="2.0944"  v_max="3.14"/>
      <xacro:joint_interface joint_name="joint_3" p_min="-2.61799" p_max="2.61799" v_max="3.14"/>
      <xacro:joint_interface joint_name="joint_4" p_min="-3.14159" p_max="3.14159" v_max="6.28"/>
      <xacro:joint_interface joint_name="joint_5" p_min="-2.0944"  p_max="2.0944"  v_max="6.28"/>
      <xacro:joint_interface joint_name="joint_6" p_min="-6.28318" p_max="6.28318" v_max="6.28"/>

    </ros2_control>
  </xacro:macro>

</robot>
