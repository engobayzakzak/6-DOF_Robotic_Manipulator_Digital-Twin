<?xml version="1.0"?>
<robot name="arm_6dof" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find manipulator_description)/urdf/inertials.xacro" />
  <xacro:include filename="$(find manipulator_description)/urdf/manipulator_ros2_control.xacro" />

  <xacro:arg name="use_mock_hardware" default="false" />

  <link name="world"/>

  <joint name="world_to_base_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.10"/>
      </geometry>
      <material name="dark_grey"><color rgba="0.2 0.2 0.2 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.10"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial radius="0.10" length="0.10" mass="4.0">
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </xacro:cylinder_inertial>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="150.0" velocity="3.14"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="link_1">
    <visual>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.07" length="0.15"/>
      </geometry>
      <material name="metallic_blue"><color rgba="0.0 0.35 0.7 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.07" length="0.15"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial radius="0.07" length="0.15" mass="3.5">
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
    </xacro:cylinder_inertial>
  </link>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0.08 0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0944" upper="2.0944" effort="150.0" velocity="3.14"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="link_2">
    <visual>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.40"/>
      </geometry>
      <material name="metallic_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.40"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial radius="0.05" length="0.40" mass="4.5">
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
    </xacro:cylinder_inertial>
  </link>

  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 -0.06 0.40" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.61799" upper="2.61799" effort="100.0" velocity="3.14"/>
    <dynamics damping="0.4" friction="0.1"/>
  </joint>

  <link name="link_3">
    <visual>
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.35"/>
      </geometry>
      <material name="metallic_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.35"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial radius="0.04" length="0.35" mass="2.8">
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
    </xacro:cylinder_inertial>
  </link>

  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0 0 0.35" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="50.0" velocity="6.28"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <link name="link_4">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.08"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.08"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial radius="0.035" length="0.08" mass="1.2">
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
    </xacro:cylinder_inertial>
  </link>

  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="0 0.04 0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0944" upper="2.0944" effort="30.0" velocity="6.28"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <link name="link_5">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.06"/>
      </geometry>
      <material name="metallic_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.06"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial radius="0.03" length="0.06" mass="0.8">
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
    </xacro:cylinder_inertial>
  </link>

  <joint name="joint_6" type="revolute">
    <parent link="link_5"/>
    <child link="link_6"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.28318" upper="6.28318" effort="20.0" velocity="6.28"/>
    <dynamics damping="0.1" friction="0.02"/>
  </joint>

  <link name="link_6">
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.02"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.02"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial radius="0.025" length="0.02" mass="0.4">
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
    </xacro:cylinder_inertial>
  </link>

  <joint name="tcp_joint" type="fixed">
    <parent link="link_6"/>
    <child link="tool0"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>
  <link name="tool0"/>

  <xacro:manipulator_ros2_control name="Arm6DofControlInterface" use_mock_hardware="$(arg use_mock_hardware)"/>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find manipulator_moveit_config)/config/ros2_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
